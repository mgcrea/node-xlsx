{
  "name": "node-xlsx",
  "version": "0.24.0",
  "description": "NodeJS Excel files parser & builder",
  "keywords": [
    "builder",
    "excel",
    "parser",
    "xls",
    "xlsx"
  ],
  "license": "Apache-2.0",
  "author": "Olivier Louvignes <olivier@mg-crea.com>",
  "repository": "github:mgcrea/node-xlsx",
  "bin": {
    "node-xlsx": "./dist/bin/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "exports": {
    ".": {
      "require": "./dist/index.cjs",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "start": "npm run spec -- --watch",
    "build": "tsup --entry src/index.ts --format cjs,esm --sourcemap --dts --clean --entry src/bin/cli.ts",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit",
    "spec": "DEBUG=node-xlsx* vitest --run",
    "watch": "DEBUG=node-xlsx* vitest --watch",
    "test": "pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm run spec",
    "prepublishOnly": "npm run build",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.2/xlsx-0.20.2.tgz"
  },
  "devDependencies": {
    "@tsconfig/node-lts": "^20.1.1",
    "@types/node": "^20.12.7",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "tsup": "^8.0.2",
    "typescript": "^5.4.5",
    "vite-tsconfig-paths": "^4.3.2",
    "vitest": "^1.5.0"
  },
  "engines": {
    "node": ">=10.0.0"
  }
}
