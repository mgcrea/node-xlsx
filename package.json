{
  "name": "node-xlsx",
  "version": "0.25.0",
  "description": "NodeJS Excel files parser & builder",
  "keywords": [
    "builder",
    "excel",
    "parser",
    "xls",
    "xlsx"
  ],
  "license": "Apache-2.0",
  "author": "Olivier Louvignes <olivier@mg-crea.com>",
  "repository": "github:mgcrea/node-xlsx",
  "bin": {
    "node-xlsx": "./dist/bin/cli.mjs"
  },
  "files": [
    "dist",
    "NOTICE",
    "LICENSE-SheetJS"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "start": "npm run spec -- --watch",
    "build": "tsdown",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit",
    "spec": "DEBUG=node-xlsx* vitest --run",
    "watch": "DEBUG=node-xlsx* vitest --watch",
    "test": "pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm run spec",
    "prepublishOnly": "npm run build",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check ."
  },
  "devDependencies": {
    "@tsconfig/node-lts": "^20.1.1",
    "@types/node": "^20.19.43",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "tsdown": "^0.23.7",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.7",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@10.33.2"
}
